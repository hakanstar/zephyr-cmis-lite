/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * On-chip monitors: die temperature sensor and internal reference
 * voltage (VREFINT, used to compute VDDA), both on ADC1.
 * ADCCLK = APB2 (84 MHz) / 4 = 21 MHz, within the 36 MHz limit.
 */
&adc123_common {
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc1 {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&vref {
	status = "okay";
};
